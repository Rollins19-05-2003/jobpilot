# Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Telegram: create bot via @BotFather, get chat_id via /getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: JSearch on RapidAPI (free ~200 req/month) for LinkedIn/Naukri/Indeed
# coverage via Google-for-Jobs. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Leave default for local SQLite; swap for Supabase Postgres later
# DATABASE_URL=postgresql://user:pass@host:5432/jobpilot

STRONG_FIT_THRESHOLD=75
MIN_FIT_TO_KEEP=40
